# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# ─────────────────────────────────────────────────────────────────────────────
# Hexah „Dzikie Ziemie" integration (optional; leave empty for vanilla play)
# ─────────────────────────────────────────────────────────────────────────────
# Server-to-server PvE battles initiated by Hexah Strapi. All values are empty by
# default, which keeps every integration hook a no-op (vanilla deployments are
# unaffected). See docs/Hexah-DzikieZiemie.md for the full flow.

# Shared secret authorizing trusted S2S create_game calls from Hexah (sent as the
# X-Internal-Key header) without a player JWT. MUST equal INTERNAL_API_KEY on the
# Hexah Strapi side. Empty = normal Bearer/admin-token auth only.
INTERNAL_API_KEY=

# Where to POST the HMAC-signed game-end result. Points at the Hexah Strapi
# endpoint, e.g. http://hexah:1337/api/hex-map-wilds/result (same docker network)
# or https://prod.hexah.pl/api/hex-map-wilds/result. Empty = result webhook off.
RESULT_WEBHOOK_URL=

# HMAC-SHA256 secret used to sign the result body (X-Wild-Signature). MUST equal
# RESULT_WEBHOOK_SECRET on the Hexah Strapi side. Empty = result webhook off.
RESULT_WEBHOOK_SECRET=

# Prerequisites for the embedded battle to work (self-hosted Hexah setup):
#   EXTERNAL_API_DISABLED=true   # no openfront-api service
#   GAME_ENV=dev                 # accept a raw persistentID as the join token
#                                # (the embedded player presents the per-battle id)
#   NUM_WORKERS=<N>              # MUST equal OPENFRONT_NUM_WORKERS on the Hexah side
